/* DockFlip — Norwegian Bokmål (norsk bokmål) */

"DockFlip Setup" = "Konfigurer DockFlip";
"Back" = "Tilbake";
"Welcome to DockFlip" = "Velkommen til DockFlip";
"Your Dock works like the Windows taskbar, ⌘Tab switches windows, and windows snap into place — in one small app that works as soon as it starts." = "Dock fungerer som oppgavelinjen i Windows, ⌘Tab bytter mellom vinduer, og vinduer festes på plass – i én liten app som virker med en gang den starter.";
"Open System Settings" = "Åpne Systeminnstillinger";
"DockFlip is already switched on in the list, but nothing changes?" = "DockFlip er allerede slått på i listen, men ingenting skjer?";
"Reset Permission" = "Nullstill tillatelse";
"Launch at login" = "Åpne ved pålogging";
"Done" = "Ferdig";
"Dock" = "Dock";
"Rest on an icon to see its windows and tabs. Click to minimize and restore." = "Hold pekeren over et symbol for å se vinduene og fanene. Klikk for å minimere og gjenopprette.";
"Switch between windows, not just apps." = "Bytt mellom vinduer, ikke bare apper.";
"Snapping" = "Fest vinduer";
"Drag to an edge or press ⌃⌥ and an arrow." = "Dra til en kant eller trykk på ⌃⌥ og en piltast.";
"Allow Accessibility" = "Tillat Tilgjengelighet";
"DockFlip needs one permission. It is used to list, focus, move and minimize windows, and for the ⌘Tab and ⌃⌥ shortcuts." = "DockFlip trenger én tillatelse. Den brukes til å vise, aktivere, flytte og minimere vinduer, og til snarveiene ⌘Tab og ⌃⌥.";
"DockFlip has no networking code and no third-party code. Nothing it sees leaves your Mac." = "DockFlip har ingen nettverkskode og ingen kode fra tredjeparter. Ingenting den ser, forlater Macen din.";
"Show window thumbnails?" = "Vise miniatyrbilder av vinduer?";
"Choose how windows look in the Dock list and in ⌘Tab. You can change this later in Settings." = "Velg hvordan vinduer vises i Dock-listen og i ⌘Tab. Du kan endre dette senere i Innstillinger.";
"Icon and title" = "Symbol og tittel";
"No extra permission. Windows are told apart by title and a mini-map of where they are on screen." = "Ingen ekstra tillatelse. Vinduer skilles fra hverandre med tittel og et minikart over hvor på skjermen de er.";
"Thumbnails" = "Miniatyrbilder";
"Needs the Screen & System Audio Recording permission." = "Krever tillatelsen Skjerm- og systemlydopptak.";
"Screen recording permission technically gives access to everything on screen. DockFlip captures only a small image of one window, only while you rest on a Dock icon or use ⌘Tab, keeps it in memory only and never while a password field is active." = "Tillatelsen til skjermopptak gir teknisk sett tilgang til alt på skjermen. DockFlip tar bare et lite bilde av ett vindu, bare mens du holder pekeren over et Dock-symbol eller bruker ⌘Tab, lagrer det bare i minnet og aldri mens et passordfelt er aktivt.";
"Almost done" = "Nesten ferdig";
"One quick adjustment makes DockFlip work like Windows. It is a single click." = "Én rask justering får DockFlip til å fungere som Windows. Det krever bare ett klikk.";
"Turn off macOS edge tiling" = "Slå av macOS-plassering av vinduer ved kantene";
"macOS tiles windows dragged to screen edges too. Two snapping systems would fight." = "macOS plasserer også vinduer som dras til skjermkantene. To systemer for å feste vinduer ville kommet i konflikt.";
