/* DockFlip — Swedish (svenska) */

"DockFlip Setup" = "Konfigurera DockFlip";
"Back" = "Tillbaka";
"Welcome to DockFlip" = "Välkommen till DockFlip";
"Your Dock works like the Windows taskbar, ⌘Tab switches windows, and windows snap into place — in one small app that works as soon as it starts." = "Din Dock fungerar som aktivitetsfältet i Windows, ⌘Tab växlar mellan fönster och fönster fästs på plats – i en liten app som fungerar så fort den startar.";
"Open System Settings" = "Öppna Systeminställningar";
"DockFlip is already switched on in the list, but nothing changes?" = "DockFlip är redan påslaget i listan men ingenting händer?";
"Reset Permission" = "Återställ behörighet";
"Launch at login" = "Öppna vid inloggning";
"Done" = "Klart";
"Dock" = "Dock";
"Rest on an icon to see its windows and tabs. Click to minimize and restore." = "Vila pekaren på en symbol för att se dess fönster och flikar. Klicka för att minimera och återställa.";
"Switch between windows, not just apps." = "Växla mellan fönster, inte bara appar.";
"Snapping" = "Fäst fönster";
"Drag to an edge or press ⌃⌥ and an arrow." = "Dra till en kant eller tryck på ⌃⌥ och en piltangent.";
"Allow Accessibility" = "Tillåt Hjälpmedel";
"DockFlip needs one permission. It is used to list, focus, move and minimize windows, and for the ⌘Tab and ⌃⌥ shortcuts." = "DockFlip behöver en behörighet. Den används för att lista, aktivera, flytta och minimera fönster samt för kortkommandona ⌘Tab och ⌃⌥.";
"DockFlip has no networking code and no third-party code. Nothing it sees leaves your Mac." = "DockFlip innehåller ingen nätverkskod och ingen kod från tredje part. Inget av det den ser lämnar din Mac.";
"Show window thumbnails?" = "Visa fönsterminiatyrer?";
"Choose how windows look in the Dock list and in ⌘Tab. You can change this later in Settings." = "Välj hur fönster visas i Dock-listan och i ⌘Tab. Du kan ändra detta senare i Inställningar.";
"Icon and title" = "Symbol och titel";
"No extra permission. Windows are told apart by title and a mini-map of where they are on screen." = "Ingen extra behörighet. Fönster skiljs åt med titel och en minikarta över var på skärmen de finns.";
"Thumbnails" = "Miniatyrer";
"Needs the Screen & System Audio Recording permission." = "Kräver behörigheten Skärm- och systemljudsinspelning.";
"Screen recording permission technically gives access to everything on screen. DockFlip captures only a small image of one window, only while you rest on a Dock icon or use ⌘Tab, keeps it in memory only and never while a password field is active." = "Behörigheten för skärminspelning ger tekniskt sett åtkomst till allt på skärmen. DockFlip tar bara en liten bild av ett fönster, bara medan du vilar pekaren på en Dock-symbol eller använder ⌘Tab, sparar den bara i minnet och aldrig medan ett lösenordsfält är aktivt.";
"Almost done" = "Nästan klart";
"One quick adjustment makes DockFlip work like Windows. It is a single click." = "En snabb justering får DockFlip att fungera som Windows. Det krävs bara ett klick.";
"Turn off macOS edge tiling" = "Stäng av macOS fönsterplacering vid kanter";
"macOS tiles windows dragged to screen edges too. Two snapping systems would fight." = "macOS placerar också fönster som dras till skärmkanterna. Två system för att fästa fönster skulle krocka.";
