/* DockFlip — Danish (dansk) */

"DockFlip Setup" = "Konfigurer DockFlip";
"Back" = "Tilbage";
"Welcome to DockFlip" = "Velkommen til DockFlip";
"Your Dock works like the Windows taskbar, ⌘Tab switches windows, and windows snap into place — in one small app that works as soon as it starts." = "Din Dock fungerer som proceslinjen i Windows, ⌘Tab skifter mellem vinduer, og vinduer lægger sig på plads – i én lille app, der virker, så snart den starter.";
"Open System Settings" = "Åbn Systemindstillinger";
"DockFlip is already switched on in the list, but nothing changes?" = "DockFlip er allerede slået til på listen, men der sker ikke noget?";
"Reset Permission" = "Nulstil tilladelse";
"Launch at login" = "Åbn ved login";
"Done" = "Færdig";
"Dock" = "Dock";
"Rest on an icon to see its windows and tabs. Click to minimize and restore." = "Hold markøren over et symbol for at se dets vinduer og faner. Klik for at minimere og gendanne.";
"Switch between windows, not just apps." = "Skift mellem vinduer, ikke kun apps.";
"Snapping" = "Fastgør vinduer";
"Drag to an edge or press ⌃⌥ and an arrow." = "Træk til en kant, eller tryk på ⌃⌥ og en piletast.";
"Allow Accessibility" = "Tillad Tilgængelighed";
"DockFlip needs one permission. It is used to list, focus, move and minimize windows, and for the ⌘Tab and ⌃⌥ shortcuts." = "DockFlip skal bruge én tilladelse. Den bruges til at vise, aktivere, flytte og minimere vinduer og til genvejene ⌘Tab og ⌃⌥.";
"DockFlip has no networking code and no third-party code. Nothing it sees leaves your Mac." = "DockFlip indeholder ingen netværkskode og ingen kode fra tredjeparter. Intet af det, den ser, forlader din Mac.";
"Show window thumbnails?" = "Vis vinduesminiaturer?";
"Choose how windows look in the Dock list and in ⌘Tab. You can change this later in Settings." = "Vælg, hvordan vinduer vises på Dock-listen og i ⌘Tab. Du kan ændre det senere i Indstillinger.";
"Icon and title" = "Symbol og titel";
"No extra permission. Windows are told apart by title and a mini-map of where they are on screen." = "Ingen ekstra tilladelse. Vinduer skelnes ved titel og et minikort over, hvor på skærmen de er.";
"Thumbnails" = "Miniaturer";
"Needs the Screen & System Audio Recording permission." = "Kræver tilladelsen Skærm- og systemlydoptagelse.";
"Screen recording permission technically gives access to everything on screen. DockFlip captures only a small image of one window, only while you rest on a Dock icon or use ⌘Tab, keeps it in memory only and never while a password field is active." = "Tilladelsen til skærmoptagelse giver teknisk set adgang til alt på skærmen. DockFlip tager kun et lille billede af ét vindue, kun mens du holder markøren over et Dock-symbol eller bruger ⌘Tab, gemmer det kun i hukommelsen og aldrig, mens et adgangskodefelt er aktivt.";
"Almost done" = "Næsten færdig";
"One quick adjustment makes DockFlip work like Windows. It is a single click." = "En hurtig justering får DockFlip til at fungere som Windows. Det kræver kun ét klik.";
"Turn off macOS edge tiling" = "Slå macOS' kantplacering af vinduer fra";
"macOS tiles windows dragged to screen edges too. Two snapping systems would fight." = "macOS placerer også vinduer, der trækkes til skærmkanterne. To systemer til fastgørelse af vinduer ville komme i konflikt.";
